# --- Aplicație ---
APP_URL=http://localhost:3000
APP_NAME=Contractez
# Secret folosit pentru semnături interne (generează: openssl rand -hex 32)
APP_SECRET=change-me
# Emailuri cu drept de admin (separate prin virgulă). Primesc rolul admin la înregistrare.
ADMIN_EMAILS=

# --- Bază de date & Redis ---
DATABASE_URL=postgres://prestio:prestio@localhost:5442/prestio
REDIS_URL=redis://localhost:6392

# --- OpenAI (opțional: fără cheie, funcțiile AI folosesc reguli simple) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Resend (opțional: fără cheie, emailurile sunt doar salvate în /admin/emailuri) ---
RESEND_API_KEY=
EMAIL_FROM="Contractez <noreply@contractez.ro>"

# --- Stripe: abonamente Pro / Business pentru prestatori ---
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe e vânzătorul oficial (merchant of record): TVA, facturi și chitanțe către clienți le face Stripe/Link.
# Necesită acces aprobat: Dashboard → Settings → Managed Payments.
STRIPE_MANAGED_PAYMENTS=true
STRIPE_TAX_CODE=txcd_10103001
# Prețuri recurente create în Stripe pentru Pro și Business (opțional, dar necesare ca prestatorii să poată schimba planul din portal)
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Producție (Caddy) ---
DOMAIN=localhost
POSTGRES_PASSWORD=prestio

# --- SMS (opțional, pentru verificarea telefonului) ---
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Effort de raționament pentru modelele OpenAI (none|minimal|low|medium|high)
OPENAI_REASONING_EFFORT=low

# --- Autentificare cu Google (opțional) ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- VisitTrack (opțional: analytics) ---
# Id-ul site-ului din snippet-ul de instalare visitrack.app (public) și cheia API a site-ului (evenimente de pe server).
VISITRACK_SITE_ID=
VISITRACK_API_KEY=

# --- Crisp (opțional: chat de suport, încărcat doar la click) ---
CRISP_WEBSITE_ID=
