{
  "manifest_version": 3,
  "name": "Contractez Copilot",
  "short_name": "Contractez",
  "version": "0.4.0",
  "description": "Asistent local pentru outreach în grupurile de Facebook: citește ce ai derulat deja. În tab-ul cozii apasă „Începe conversația”, marchează lead-ul după ce trimiți tu și trece la următorul. Nu scrie și nu trimite mesaje.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "scripting",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://contractez.ro/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "extract.js",
        "content-group.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "extract.js",
        "content-messenger.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://contractez.ro/admin/*",
        "http://localhost:3000/admin/*"
      ],
      "js": [
        "content-queue.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Contractez Copilot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
