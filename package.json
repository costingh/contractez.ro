{
  "name": "freelancing-platform-ro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "worker": "tsx watch --env-file=.env src/worker/index.ts",
    "db:generate": "drizzle-kit generate && node scripts/fix-migrations.mjs",
    "db:migrate": "tsx --env-file=.env src/scripts/migrate.ts",
    "db:seed-demo": "tsx --env-file=.env src/scripts/seed-demo.ts",
    "db:studio": "drizzle-kit studio",
    "services:up": "docker compose -f compose.yml -f compose.dev.yml up -d postgres redis",
    "build:scripts": "node scripts/build-scripts.mjs",
    "test:unit": "vitest run --config vitest.unit.config.mts"
  },
  "dependencies": {
    "bullmq": "^6.3.16",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "openai": "^7.38.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.13.0"
}
